{
  "name": "meta-agent",
  "version": "0.0.41",
  "private": true,
  "description": "Meta Agent desktop application",
  "homepage": "https://github.com/tanliuyi/meta-agent-harness",
  "author": {
    "name": "tanliuyi",
    "email": "tanliuyi@chichuang.com"
  },
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "prepare:node-pty": "node ../../scripts/prepare-desktop-node-pty.mjs",
    "prepare:managed-shell": "node ../../scripts/prepare-desktop-managed-shell.mjs",
    "generate-routes": "tsr generate",
    "predev": "npm run prepare:node-pty && npm run generate-routes",
    "build:sidecar": "node ../../scripts/build-desktop-sidecar.mjs",
    "dev": "npm run build:sidecar && electron-vite dev",
    "prepreview": "npm run prepare:node-pty && npm run generate-routes",
    "preview": "npm run build:sidecar && electron-vite preview",
    "pretypecheck": "npm run generate-routes",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.sidecar.check.json && tsc --noEmit -p tsconfig.web.json",
    "prebuild": "npm run prepare:node-pty",
    "build": "npm run build:sidecar && npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "build:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "build:mac": "npm run build && electron-builder --config electron-builder.yml --mac",
    "smoke:sidecar": "node ../../scripts/smoke-desktop-sidecar.mjs",
    "smoke:gui": "node ../../scripts/smoke-desktop-gui.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@floating-ui/react": "0.27.20",
    "@rc-component/image": "1.10.0",
    "@tanstack/react-virtual": "3.14.9",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "electron-devtools-installer": "4.0.0",
    "electron-updater": "6.8.9",
    "electron-window-state": "5.0.3",
    "fflate": "0.8.2",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "react-material-vscode-icons": "0.1.0",
    "safe-regex2": "5.1.1",
    "semver": "7.8.0",
    "typebox": "1.3.10",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.12",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@assistant-ui/react-devtools": "1.2.13",
    "@assistant-ui/react-lexical": "0.2.9",
    "@assistant-ui/react-streamdown": "0.3.10",
    "@radix-ui/react-alert-dialog": "1.1.19",
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-context-menu": "2.3.3",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-radio-group": "1.4.3",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-toast": "1.2.19",
    "@radix-ui/react-tooltip": "1.2.12",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-plugin": "1.168.23",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-link": "3.30.2",
    "@tiptap/extension-placeholder": "3.30.2",
    "@tiptap/markdown": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "katex": "0.16.27",
    "lucide-react": "1.24.0",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.11",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.9",
    "zustand": "5.0.14"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
