{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-office-engine": ["../office-engine/src/index.ts"],
      "@renderer/*": ["src/renderer/src/*"]
    },
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "../office-engine/src/**/*.ts"
  ],
  "exclude": ["src/shared/sidecar-wire.ts"]
}
