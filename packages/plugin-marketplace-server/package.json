{
  "name": "@earendil-works/plugin-marketplace-server",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS backend for the Meta Agent Desktop plugin marketplace",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "migrate:sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "postgres:state": "tsx scripts/postgres-state.ts",
    "start": "node dist/main.js",
    "test": "vitest --run",
    "typecheck": "tsgo --noEmit -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "fflate": "0.8.2",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "safe-regex2": "5.1.1",
    "semver": "7.8.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/pg": "8.20.0",
    "@types/semver": "7.7.1",
    "@types/supertest": "7.2.1",
    "pg-mem": "3.0.14",
    "supertest": "7.2.2",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
