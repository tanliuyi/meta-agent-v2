MARKETPLACE_HOST=127.0.0.1
MARKETPLACE_PORT=4317
MARKETPLACE_BASE_PATH=
MARKETPLACE_PUBLIC_BASE_URL=http://127.0.0.1:4317
MARKETPLACE_ID=meta-agent-development
MARKETPLACE_ARTIFACT_ORIGINS=
MARKETPLACE_SIGNING_PRIVATE_KEY=
MARKETPLACE_ALLOW_EPHEMERAL_SIGNING_KEY=true
MARKETPLACE_ADMIN_TOKEN=
MARKETPLACE_DATABASE_URL=postgresql://marketplace:change-me@127.0.0.1:5432/plugin_marketplace
MARKETPLACE_MINIO_ENDPOINT=http://127.0.0.1:9000
MARKETPLACE_MINIO_ACCESS_KEY=marketplace
MARKETPLACE_MINIO_SECRET_KEY=change-me
MARKETPLACE_MINIO_BUCKET=meta-agent-plugins
MARKETPLACE_MINIO_REGION=us-east-1
MARKETPLACE_DEFAULT_ADMIN_USERNAME=admin
MARKETPLACE_DEFAULT_ADMIN_PASSWORD=
MARKETPLACE_DEFAULT_SUPER_USERNAME=super
MARKETPLACE_DEFAULT_SUPER_PASSWORD=
MARKETPLACE_MAX_ARTIFACT_BYTES=33554432
MARKETPLACE_ALLOW_REGISTRATION=false
MARKETPLACE_MAX_LOGIN_FAILURES=10

# Compose 基础设施变量；生产环境必须替换所有 change-me。
