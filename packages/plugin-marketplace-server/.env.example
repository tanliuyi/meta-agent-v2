MARKETPLACE_HOST=127.0.0.1
MARKETPLACE_PORT=4317
MARKETPLACE_BASE_PATH=
MARKETPLACE_PUBLIC_BASE_URL=http://127.0.0.1:4317
MARKETPLACE_ID=meta-agent-development
MARKETPLACE_ARTIFACT_ORIGINS=https://plugins.example.com
# Base64-encoded PKCS#8 PEM. Required unless ephemeral keys are explicitly enabled.
MARKETPLACE_SIGNING_PRIVATE_KEY=
MARKETPLACE_ALLOW_EPHEMERAL_SIGNING_KEY=true
# SQLite data directory. Empty means an in-memory store seeded from catalog/plugins.json.
# A persistent data directory requires a pinned signing key.
MARKETPLACE_DATA_DIR=
# Static bearer token (>= 16 characters) for /v1/admin endpoints. Empty disables admin APIs.
MARKETPLACE_ADMIN_TOKEN=
# Maximum accepted artifact upload size in bytes (default 32 MiB).
MARKETPLACE_MAX_ARTIFACT_BYTES=
# Set to false to disable self-service account registration.
MARKETPLACE_ALLOW_REGISTRATION=
# Failed login attempts allowed per client IP within a 15-minute window before
# further logins return 429 AUTH_RATE_LIMITED (default 10, 0 disables throttling).
MARKETPLACE_MAX_LOGIN_FAILURES=
