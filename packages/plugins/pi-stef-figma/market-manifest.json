{
  "schemaVersion": 1,
  "marketplaceId": "meta-agent-development",
  "artifactId": "pi-stef-figma-local",
  "plugin": {
    "id": "pi-stef.figma",
    "name": "Figma Design",
    "version": "0.3.5-local",
    "publisherId": "meta-agent"
  },
  "pi": {
    "entry": "extensions/figma.ts",
    "extensionApi": "v1"
  },
  "desktop": {
    "hostProfileVersion": 1
  },
  "target": {
    "platform": "universal",
    "arch": "universal"
  },
  "configuration": {
    "version": 1,
    "fields": [
      {
        "key": "apiToken",
        "label": "Figma API Token",
        "type": "secret",
        "minLength": 1,
        "placeholder": "输入 Figma personal access token",
        "group": "认证",
        "order": 1,
        "description": "Figma personal access token（需 file_content:read 等只读 scope）。留空时回退到 ~/.pi/sf/figma/config.json 或 FIGMA_API_TOKEN 环境变量。"
      },
      {
        "key": "fileKey",
        "label": "默认文件 Key",
        "type": "text",
        "maxLength": 64,
        "placeholder": "如 abc123XYZ",
        "group": "认证",
        "order": 2,
        "description": "figma_auth_status 未显式传 fileKey 时用于验证 API 访问的可选文件 key。"
      }
    ]
  },
  "capabilities": [
    "configuration.read",
    "tools.register"
  ],
  "nativeModules": [],
  "executables": [],
  "files": {
    "extensions/figma.ts": { "mode": "0644" },
    "src/index.ts": { "mode": "0644" },
    "src/auth/FigmaAuthorization.ts": { "mode": "0644" },
    "src/cache/FigmaCache.ts": { "mode": "0644" },
    "src/client/FigmaClient.ts": { "mode": "0644" },
    "src/client/FigmaErrors.ts": { "mode": "0644" },
    "src/client/rateLimit.ts": { "mode": "0644" },
    "src/context/FigmaApi.ts": { "mode": "0644" },
    "src/context/FigmaContext.ts": { "mode": "0644" },
    "src/context/FigmaNodeParser.ts": { "mode": "0644" },
    "src/schemas.ts": { "mode": "0644" },
    "src/toolResult.ts": { "mode": "0644" },
    "src/transform/assets.ts": { "mode": "0644" },
    "src/transform/compactNode.ts": { "mode": "0644" },
    "src/transform/designContext.ts": { "mode": "0644" },
    "src/transform/implementationContext.ts": { "mode": "0644" },
    "src/transform/text.ts": { "mode": "0644" },
    "src/transform/tokens.ts": { "mode": "0644" },
    "src/url.ts": { "mode": "0644" },
    "assets/icon.svg": { "mode": "0644" }
  }
}
