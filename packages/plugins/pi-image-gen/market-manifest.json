{
  "schemaVersion": 1,
  "marketplaceId": "meta-agent-development",
  "artifactId": "pi-image-gen-local",
  "plugin": {
    "id": "pi.image-gen",
    "name": "Image Generation",
    "version": "0.0.0-local",
    "publisherId": "meta-agent"
  },
  "pi": {
    "entry": "index.ts",
    "extensionApi": "v1"
  },
  "desktop": {
    "hostProfileVersion": 1
  },
  "target": {
    "platform": "universal",
    "arch": "universal"
  },
  "configuration": {
    "version": 1,
    "fields": [
      {
        "key": "defaultModel",
        "label": "默认模型",
        "type": "select",
        "required": true,
        "defaultValue": "gpt-image-2",
        "options": [
          {
            "value": "gpt-image-2",
            "label": "gpt-image-2",
            "description": "OpenAI"
          },
          {
            "value": "gemini-3-pro-image",
            "label": "gemini-3-pro-image",
            "description": "Google Gemini · 别名 nano-banana-pro"
          },
          {
            "value": "gemini-3.1-flash-image",
            "label": "gemini-3.1-flash-image",
            "description": "Google Gemini · 别名 nano-banana-2"
          },
          {
            "value": "gemini-3.1-flash-lite-image",
            "label": "gemini-3.1-flash-lite-image",
            "description": "Google Gemini · 别名 nano-banana-2-lite"
          },
          {
            "value": "gemini-2.5-flash-image",
            "label": "gemini-2.5-flash-image",
            "description": "Google Gemini · 别名 nano-banana"
          },
          {
            "value": "qwen-image-2.0-pro",
            "label": "qwen-image-2.0-pro",
            "description": "Alibaba DashScope"
          },
          {
            "value": "qwen-image-2.0",
            "label": "qwen-image-2.0",
            "description": "Alibaba DashScope"
          },
          {
            "value": "doubao-seedream-5-0-pro-260128",
            "label": "doubao-seedream-5-0-pro-260128",
            "description": "Volcengine Ark · 别名 seedream-5-pro"
          },
          {
            "value": "doubao-seedream-5-0-260128",
            "label": "doubao-seedream-5-0-260128",
            "description": "Volcengine Ark · 别名 seedream-5、seedream"
          },
          {
            "value": "doubao-seedream-5-0-lite-260128",
            "label": "doubao-seedream-5-0-lite-260128",
            "description": "Volcengine Ark · 别名 seedream-5-lite"
          },
          {
            "value": "doubao-seedream-4-5-251128",
            "label": "doubao-seedream-4-5-251128",
            "description": "Volcengine Ark · 别名 seedream-4-5"
          },
          {
            "value": "doubao-seedream-4-0-250828",
            "label": "doubao-seedream-4-0-250828",
            "description": "Volcengine Ark · 别名 seedream-4"
          },
          {
            "value": "custom",
            "label": "自定义模型…"
          }
        ],
        "description": "内置模型快捷选择，共 12 个（含别名）。 使用 OpenRouter 等自定义模型时选择「自定义模型…」并填写下面的自定义模型字段。",
        "order": 1
      },
      {
        "key": "customModel",
        "label": "自定义模型",
        "type": "text",
        "placeholder": "openrouter/<厂商>/<模型>",
        "description": "任意模型 ID（如 openrouter/deepseek/deepseek-chat），填写后优先于上面的内置模型选择。需要配置对应提供商的 API Key。",
        "order": 2
      },
      {
        "key": "outputDir",
        "label": "输出目录",
        "type": "path",
        "defaultValue": ".pi/images",
        "placeholder": ".pi/images",
        "description": "生成图片的保存目录，相对于会话工作目录，也可以填绝对路径。",
        "order": 3
      },
      {
        "key": "openaiApiKey",
        "label": "API Key",
        "type": "secret",
        "group": "OpenAI",
        "order": 4,
        "placeholder": "输入 API 密钥",
        "minLength": 8,
        "description": "OpenAI 的 API 密钥，保存后由系统凭据加密存储。留空时回退到环境变量 OPENAI_API_KEY。"
      },
      {
        "key": "openaiBaseUrl",
        "label": "Base URL",
        "type": "text",
        "group": "OpenAI",
        "order": 5,
        "placeholder": "https://api.openai.com/v1",
        "pattern": "^https?://",
        "patternMessage": "必须以 http:// 或 https:// 开头",
        "description": "覆盖 OpenAI 的默认接口地址，默认 https://api.openai.com/v1。一般无需修改。"
      },
      {
        "key": "geminiApiKey",
        "label": "API Key",
        "type": "secret",
        "group": "Google Gemini",
        "order": 6,
        "placeholder": "输入 API 密钥",
        "minLength": 8,
        "description": "Google Gemini 的 API 密钥，保存后由系统凭据加密存储。留空时回退到环境变量 GEMINI_API_KEY。"
      },
      {
        "key": "geminiBaseUrl",
        "label": "Base URL",
        "type": "text",
        "group": "Google Gemini",
        "order": 7,
        "placeholder": "https://generativelanguage.googleapis.com/v1beta",
        "pattern": "^https?://",
        "patternMessage": "必须以 http:// 或 https:// 开头",
        "description": "覆盖 Google Gemini 的默认接口地址，默认 https://generativelanguage.googleapis.com/v1beta。一般无需修改。"
      },
      {
        "key": "dashscopeApiKey",
        "label": "API Key",
        "type": "secret",
        "group": "Alibaba DashScope",
        "order": 8,
        "placeholder": "输入 API 密钥",
        "minLength": 8,
        "description": "Alibaba DashScope 的 API 密钥，保存后由系统凭据加密存储。留空时回退到环境变量 DASHSCOPE_API_KEY。"
      },
      {
        "key": "dashscopeBaseUrl",
        "label": "Base URL",
        "type": "text",
        "group": "Alibaba DashScope",
        "order": 9,
        "placeholder": "https://dashscope.aliyuncs.com/api/v1",
        "pattern": "^https?://",
        "patternMessage": "必须以 http:// 或 https:// 开头",
        "description": "覆盖 Alibaba DashScope 的默认接口地址，默认 https://dashscope.aliyuncs.com/api/v1。一般无需修改。"
      },
      {
        "key": "arkApiKey",
        "label": "API Key",
        "type": "secret",
        "group": "Volcengine Ark",
        "order": 10,
        "placeholder": "输入 API 密钥",
        "minLength": 8,
        "description": "Volcengine Ark 的 API 密钥，保存后由系统凭据加密存储。留空时回退到环境变量 ARK_API_KEY。"
      },
      {
        "key": "arkBaseUrl",
        "label": "Base URL",
        "type": "text",
        "group": "Volcengine Ark",
        "order": 11,
        "placeholder": "https://ark.cn-beijing.volces.com/api/v3",
        "pattern": "^https?://",
        "patternMessage": "必须以 http:// 或 https:// 开头",
        "description": "覆盖 Volcengine Ark 的默认接口地址，默认 https://ark.cn-beijing.volces.com/api/v3。一般无需修改。"
      },
      {
        "key": "openrouterApiKey",
        "label": "API Key",
        "type": "secret",
        "group": "OpenRouter",
        "order": 12,
        "placeholder": "输入 API 密钥",
        "minLength": 8,
        "description": "OpenRouter 的 API 密钥，保存后由系统凭据加密存储。留空时回退到环境变量 OPENROUTER_API_KEY。"
      },
      {
        "key": "openrouterBaseUrl",
        "label": "Base URL",
        "type": "text",
        "group": "OpenRouter",
        "order": 13,
        "placeholder": "https://openrouter.ai/api/v1",
        "pattern": "^https?://",
        "patternMessage": "必须以 http:// 或 https:// 开头",
        "description": "覆盖 OpenRouter 的默认接口地址，默认 https://openrouter.ai/api/v1。一般无需修改。"
      }
    ]
  },
  "capabilities": [
    "events.subscribe",
    "configuration.read",
    "tools.register"
  ],
  "nativeModules": [],
  "executables": [],
  "files": {
    "index.ts": {
      "mode": "0644"
    }
  }
}
