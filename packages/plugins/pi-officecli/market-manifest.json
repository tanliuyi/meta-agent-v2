{
  "schemaVersion": 1,
  "marketplaceId": "meta-agent-development",
  "artifactId": "pi-officecli-local",
  "plugin": {
    "id": "pi.officecli",
    "name": "Office Documents (OfficeCLI)",
    "version": "0.0.0-local",
    "publisherId": "meta-agent"
  },
  "pi": {
    "entry": "index.ts",
    "extensionApi": "v1",
    "skills": ["skills/pi-officecli/SKILL.md"],
    "pluginCall": {
      "skill": "pi-officecli",
      "catalog": "plugin-api.json"
    }
  },
  "desktop": {
    "hostProfileVersion": 1,
    "minVersion": "0.0.42"
  },
  "target": {
    "platform": "universal",
    "arch": "universal"
  },
  "configuration": {
    "version": 1,
    "fields": [
      {
        "key": "binaryPath",
        "label": "OfficeCLI 二进制路径",
        "type": "path",
        "required": false,
        "description": "已安装的 officecli 可执行文件绝对路径。留空时插件会自动下载官方发布的平台二进制（固定版本 tag，SHA256 校验）。",
        "order": 1
      },
      {
        "key": "version",
        "label": "下载版本",
        "type": "text",
        "defaultValue": "v1.0.143",
        "placeholder": "v1.0.143",
        "description": "自动下载时使用的 GitHub Release tag（如 v1.0.143）。仅在未配置 binaryPath 时生效。",
        "order": 2
      },
      {
        "key": "autoDownload",
        "label": "自动下载二进制",
        "type": "boolean",
        "defaultValue": true,
        "description": "首次使用时自动下载 officecli 二进制到用户目录。关闭后若未安装二进制，工具将报错并提示安装方式。",
        "order": 3
      }
    ]
  },
  "capabilities": [
    "configuration.read",
    "plugin-methods.provide"
  ],
  "nativeModules": [],
  "executables": [],
  "files": {
    "index.ts": {
      "mode": "0644"
    },
    "plugin-api.json": {
      "mode": "0644"
    },
    "skills/pi-officecli/SKILL.md": {
      "mode": "0644"
    },
    "skills/pi-officecli/references/api.md": {
      "mode": "0644"
    },
    "assets/icon.png": {
      "mode": "0644"
    }
  }
}
