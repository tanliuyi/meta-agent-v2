{
  "name": "@earendil-works/pi-office-engine",
  "version": "0.83.0",
  "description": "Safe Office Open XML package inspection and transactional editing",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit -p tsconfig.build.json && tsgo --noEmit -p scripts/tsconfig.json",
    "test": "vitest --run --coverage",
    "interop:generate": "tsx scripts/office-interop.ts generate",
    "interop:validate": "tsx scripts/office-interop.ts validate",
    "interop:verify": "tsx scripts/office-interop.ts verify",
    "interop:libreoffice": "node scripts/run-libreoffice-interop.mjs",
    "interop:word": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-word-interop.ps1",
    "xlsx-interop:generate": "tsx scripts/xlsx-interop.ts generate",
    "xlsx-interop:validate": "tsx scripts/xlsx-interop.ts validate",
    "xlsx-interop:verify": "tsx scripts/xlsx-interop.ts verify",
    "xlsx-interop:libreoffice": "node scripts/run-libreoffice-xlsx-interop.mjs",
    "xlsx-interop:excel": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-excel-interop.ps1",
    "performance:check": "node --expose-gc --import tsx scripts/performance-gate.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "fast-xml-parser": "5.7.3",
    "fflate": "0.8.2",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
